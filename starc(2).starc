Funktion coroutine_resume(coro, value)
    // 恢复协程
    // 参数: coro - 协程对象, value - 传入值
    // 返回值: 协程返回值
    Wenn coro.state == "dead" then
        Ausgeben "协程已结束"
        gebe_zurueck null
    Ende Wenn
    coro.state = "running"
    result = coro.generator(value)
    coro.value = result
    // 检查是否结束
    Wenn coro.generator.is_completed then
        coro.state = "dead"
        Ausgeben "协程执行完成"
    Sonst
        coro.state = "suspended"
        Ausgeben "协程挂起"
    Ende Wenn
    gebe_zurueck result
