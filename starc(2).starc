Funktion istio_apply_traffic_policy(proxy, service, policy)
    // Istio流量策略应用
    // 参数: proxy - Istio代理, service - 目标服务
    // policy - 策略 (负载均衡, 超时, 重试等)
    // 配置负载均衡
    Wenn policy.lb == "round_robin" then
        istio_set_lb_round_robin(proxy, service)
    Sonst Wenn policy.lb == "least_request" then
        istio_set_lb_least_request(proxy, service)
    Ende Wenn
    // 配置超时
    Wenn policy.timeout != null then
        istio_set_timeout(proxy, service, policy.timeout)
    Ende Wenn
    // 配置重试
    Wenn policy.retry != null then
        istio_set_retry(proxy, service, policy.retry)
    Ende Wenn
    Ausgeben "Istio流量策略应用: " + service
