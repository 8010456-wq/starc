    // 参数: pool - 内存池, block - 要释放的块
    liste_einfuegen(pool.free_blocks, block)
    pool.allocated = pool.allocated - 1
    Ausgeben "内存池释放，剩余空闲: " + liste_laenge(pool.free_blocks)
