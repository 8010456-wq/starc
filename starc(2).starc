Funktion redis_client_connect(host, port)
    // Redis客户端连接 (RESP协议)
    // 参数: host - Redis主机, port - 端口
    // 返回值: Redis客户端
    sock = tcp_connect(host, port)
    client = {
        "socket": sock,
        "host": host,
        "port": port
    }
    Ausgeben "Redis连接成功: " + host + ":" + port
