```starc
Funktion api_gateway_init(routes)
    // API网关初始化
    // 参数: routes - 路由配置 [{path, service, method}]
    // 返回值: 网关对象
    gateway = {
        "routes": routes,
        "middleware": [],
        "cache": {}
    }
    Ausgeben "API网关初始化完成，路由数: " + liste_laenge(routes)
    gebe_zurueck gateway
Ende Funktion
Funktion api_gateway_route(gateway, request)
    // API网关路由
    // 参数: gateway - 网关对象, request - 请求对象
    // 返回值: 响应对象
    // 1. 匹配路由
    matched_route = null
    i = 0
    Solange i < liste_laenge(gateway.routes)
        route = liste_abrufen(gateway.routes, i)
        // 检查路径匹配
        Wenn request.path == route.path then
            matched_route = route
            i = liste_laenge(gateway.routes)
        Ende Wenn
        i = i + 1
    Ende Solange
    Wenn matched_route == null then
        Ausgeben "路由未找到: " + request.path
        gebe_zurueck {"status": 404, "body": "Not Found"}
    Ende Wenn
    // 2. 应用中间件
    request = apply_middleware(gateway.middleware, request)
    // 3. 转发请求到后端服务
    response = forward_to_service(matched_route.service, request)
    // 4. 缓存响应
    Wenn matched_route.cacheable then
        gateway.cache[request.path] = response
    Ende Wenn
    Ausgeben "路由完成: " + request.path + " -> " + matched_route.service
    gebe_zurueck response
Ende Funktion
