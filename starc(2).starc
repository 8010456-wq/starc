```starc
Funktion grpc_server_stream(server, method, request)
    // gRPC服务端流式响应
    // 参数: server - gRPC服务器, method - 方法名
    // request - 请求消息
    // 返回值: 响应流
    // 1. 构建响应流
    stream = {
        "method": method,
        "request": request,
        "responses": [],
        "closed": falsch
    }
    // 2. 启动流式处理
    spawn_thread(grpc_stream_handler, stream)
    Ausgeben "gRPC流式响应启动: " + method
    gebe_zurueck stream
Ende Funktion
Funktion grpc_client_stream(client, method, requests)
    // gRPC客户端流式请求
    // 参数: client - gRPC客户端, method - 方法名
    // requests - 请求流
    // 返回值: 响应
    // 1. 建立流式连接
    stream = grpc_open_stream(client, method)
    // 2. 发送所有请求
    i = 0
    Solange i < liste_laenge(requests)
        request = liste_abrufen(requests, i)
        grpc_send_stream(stream, request)
        i = i + 1
    Ende Solange
    // 3. 关闭发送端
    grpc_close_stream_send(stream)
    // 4. 接收响应
    response = grpc_recv_stream(stream)
    Ausgeben "gRPC流式请求完成，发送 " + liste_laenge(requests) + " 条"
    gebe_zurueck response
Ende Funktion
```
