    // 参数: server - Nacos服务器地址, service_name - 服务名
    // ip - 服务IP, port - 服务端口
    // 返回值: 是否成功
    // 1. 构建注册请求
    url = "http://" + server + "/nacos/v1/ns/instance"
    params = "serviceName=" + service_name
    params = params + "&ip=" + ip
    params = params + "&port=" + port
    params = params + "&ephemeral=true"
    // 2. 发送POST请求
    response = http_post(url, params)
    // 3. 解析响应
    Wenn zeichenkette_finden(response, "OK") != -1 then
        Ausgeben "Nacos注册成功: " + service_name + " (" + ip + ":" + port + ")"
        gebe_zurueck wahr
    Sonst
        Ausgeben "Nacos注册失败"
        gebe_zurueck falsch
    Ende Wenn
Ende Funktion
