Funktion event_subscribe(bus, event_type, callback)
    // 订阅事件
    // 参数: bus - 事件总线, event_type - 事件类型
    // callback - 回调函数
    Wenn bus.subscribers[event_type] == null then
        bus.subscribers[event_type] = []
    Ende Wenn
