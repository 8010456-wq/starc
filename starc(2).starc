示例613：DHCP 客户端
```starc
Funktion dhcp_client_discover()
    // DHCP客户端 - 发现阶段
    // 返回值: DHCP服务器IP
    // 1. 构建DHCP Discover报文
    xid = zufall_ganz(0, 0xFFFFFFFF)
    packet = dhcp_build_discover(xid)
    // 2. 广播发送 (端口67)
    dhcp_send_broadcast(packet, 67)
    // 3. 接收Offer
    response = dhcp_recv(68, 10) // 10秒超时
    Wenn response == "" then
        Ausgeben "DHCP超时，未收到Offer"
        gebe_zurueck null
    Ende Wenn
    // 4. 解析Offer
    offer = dhcp_parse_offer(response)
    Ausgeben "DHCP发现完成，服务器: " + offer.server_ip
    gebe_zurueck offer
Ende Funktion
Funktion dhcp_client_request(offer)
    // DHCP客户端 - 请求阶段
    // 参数: offer - DHCP Offer
    // 返回值: 分配的IP地址
    // 1. 构建Request报文
    request = dhcp_build_request(offer)
    // 2. 发送Request
    dhcp_send_broadcast(request, 67)
    // 3. 接收ACK
    ack = dhcp_recv(68, 10)
    Wenn ack == "" then
        Ausgeben "DHCP请求超时"
        gebe_zurueck null
    Ende Wenn
    // 4. 解析ACK
    ip = dhcp_parse_ack(ack)
    Ausgeben "DHCP获取IP成功: " + ip
    gebe_zurueck ip
Ende Funktion
```
示例614：NTP 时间同步
```starc
Funktion ntp_sync(ntp_server)
    // NTP时间同步
    // 参数: ntp_server - NTP服务器地址
    // 返回值: 时间偏移量(ms)
    // 1. 构建NTP请求 (48字节)
    packet = int_to_bytes(0x1B, 1) // LI=0, VN=3, Mode=3 (client)
    i = 1
    Solange i < 48
        packet = packet + int_to_bytes(0, 1)
        i = i + 1
    Ende Solange
    // 2. 记录发送时间
    t1 = jetzt()
    // 3. 发送UDP请求
    response = udp_send_recv(ntp_server, 123, packet, 5)
    // 4. 记录接收时间
    t4 = jetzt()
    // 5. 解析响应 (NTP时间戳在偏移40-47字节)
    t2 = ntp_extract_timestamp(response, 32) // 原始时间戳
    t3 = ntp_extract_timestamp(response, 40) // 接收时间戳
    // 6. 计算偏移: offset = ((t2 - t1) + (t3 - t4)) / 2
    offset = ((t2 - t1) + (t3 - t4)) / 2
    Ausgeben "NTP同步完成，偏移: " + offset + "ms"
    gebe_zurueck offset
Ende Funktion
```
示例615：SMTP 邮件发送（带附件）
```starc
Funktion smtp_send_with_attachment(server, from, to, subject, body, attachment_path)
    // SMTP发送带附件的邮件 (MIME)
    // 参数: server - SMTP服务器, from - 发件人, to - 收件人
    // subject - 主题, body - 正文, attachment_path - 附件路径
    // 1. 连接SMTP服务器
    sock = tcp_connect(server.host, server.port)
    // 2. HELO
    smtp_recv(sock)
    smtp_send(sock, "EHLO " + server.host + "\r\n")
    smtp_recv(sock)
    // 3. 身份认证 (如果启用)
    Wenn server.auth then
        smtp_auth_login(sock, server.username, server.password)
    Ende Wenn
    // 4. MAIL FROM
    smtp_send(sock, "MAIL FROM: <" + from + ">\r\n")
    smtp_recv(sock)
    // 5. RCPT TO
    smtp_send(sock, "RCPT TO: <" + to + ">\r\n")
    smtp_recv(sock)
    // 6. DATA
    smtp_send(sock, "DATA\r\n")
    smtp_recv(sock)
    // 7. 构建MIME消息
    boundary = "----=_Part_" + zufall_ganz(10000, 99999)
    message = "From: " + from + "\r\n"
    message = message + "To: " + to + "\r\n"
    message = message + "Subject: " + subject + "\r\n"
    message = message + "MIME-Version: 1.0\r\n"
    message = message + "Content-Type: multipart/mixed; boundary=" + boundary + "\r\n\r\n"
    // 正文部分
    message = message + "--" + boundary + "\r\n"
    message = message + "Content-Type: text/plain; charset=UTF-8\r\n\r\n"
    message = message + body + "\r\n\r\n"
    // 附件部分
    Wenn attachment_path != "" then
        file_data = datei_lesen(attachment_path)
        file_name = datei_name(attachment_path)
        message = message + "--" + boundary + "\r\n"
        message = message + "Content-Type: application/octet-stream\r\n"
        message = message + "Content-Transfer-Encoding: base64\r\n"
        message = message + "Content-Disposition: attachment; filename=\"" + file_name + "\"\r\n\r\n"
        message = message + base64_encode(file_data) + "\r\n\r\n"
    Ende Wenn
    message = message + "--" + boundary + "--\r\n"
    message = message + ".\r\n"
    // 8. 发送邮件
    smtp_send(sock, message)
    smtp_recv(sock)
    // 9. QUIT
    smtp_send(sock, "QUIT\r\n")
    tcp_close(sock)
    Ausgeben "邮件发送成功: " + subject + " (含附件)"
Ende Funktion
```
示例616：IMAP 邮件读取
```starc
Funktion imap_fetch_emails(server, username, password, folder)
    // IMAP获取邮件列表
    // 参数: server - IMAP服务器, username - 用户名
    // password - 密码, folder - 文件夹 (如 "INBOX")
    // 返回值: 邮件列表
    // 1. 连接
    sock = tcp_connect(server.host, server.port)
    imap_recv(sock)
    // 2. 登录
    imap_send(sock, "LOGIN " + username + " " + password + "\r\n")
    imap_recv(sock)
    // 3. 选择文件夹
    imap_send(sock, "SELECT " + folder + "\r\n")
    imap_recv(sock)
    // 4. 获取邮件列表
    imap_send(sock, "SEARCH ALL\r\n")
    response = imap_recv(sock)
    // 5. 解析邮件ID
    ids = imap_parse_search_response(response)
    emails = []
    i = 0
    Solange i < liste_laenge(ids)
        id = liste_abrufen(ids, i)
        // 获取邮件头部
        imap_send(sock, "FETCH " + id + " (BODY[HEADER.FIELDS (SUBJECT FROM DATE)])\r\n")
        header = imap_recv(sock)
        // 获取邮件正文
        imap_send(sock, "FETCH " + id + " (BODY[TEXT])\r\n")
        body = imap_recv(sock)
        email = imap_parse_email(header, body)
        liste_einfuegen(emails, email)
        i = i + 1
    Ende Solange
    // 6. 断开
    imap_send(sock, "LOGOUT\r\n")
    tcp_close(sock)
    Ausgeben "IMAP读取完成，共 " + liste_laenge(emails) + " 封邮件"
    gebe_zurueck emails
Ende Funktion
```
