示例645：熔断器（Circuit Breaker）
```starc
Funktion circuit_breaker_create(name, failure_threshold, timeout)
    // 熔断器创建
    // 参数: name - 名称, failure_threshold - 失败阈值
    // timeout - 超时时间(ms)
    // 返回值: 熔断器
    cb = {
        "name": name,
        "state": "closed", // closed, open, half_open
        "failure_count": 0,
        "success_count": 0,
        "failure_threshold": failure_threshold,
        "timeout": timeout,
        "last_failure": 0,
        "next_try": 0
    }
    Ausgeben "熔断器创建: " + name
    gebe_zurueck cb
Ende Funktion
Funktion circuit_breaker_call(cb, fn)
    // 熔断器调用
    // 参数: cb - 熔断器, fn - 被保护的函数
    // 返回值: 调用结果
    // 1. 检查熔断器状态
    Wenn cb.state == "open" then
        Wenn jetzt() >= cb.next_try then
            cb.state = "half_open"
            Ausgeben "熔断器 " + cb.name + " 进入半开状态"
        Sonst
            Ausgeben "熔断器 " + cb.name + " 打开，请求被拒绝"
            gebe_zurueck {"error": "Circuit breaker open", "fallback": cb.fallback}
        Ende Wenn
    Ende Wenn
    // 2. 执行被保护函数
    try
        result = fn()
        // 成功
        Wenn cb.state == "half_open" then
            cb.state = "closed"
            cb.failure_count = 0
            Ausgeben "熔断器 " + cb.name + " 恢复关闭状态"
        Ende Wenn
        cb.success_count = cb.success_count + 1
        gebe_zurueck {"success": wahr, "result": result}
    catch (error)
        // 失败
        cb.failure_count = cb.failure_count + 1
        cb.last_failure = jetzt()
        Wenn cb.failure_count >= cb.failure_threshold then
            cb.state = "open"
            cb.next_try = jetzt() + cb.timeout
            Ausgeben "熔断器 " + cb.name + " 触发打开状态"
        Ende Wenn
        gebe_zurueck {"success": falsch, "error": error}
    Ende Versuch
Ende Funktion
```
