Funktion api_register_version(manager, version, router)
    // 注册API版本
    // 参数: manager - 版本管理器, version - 版本号
    // router - 路由配置
    manager.versions[version] = router
    Ausgeben "API版本注册: " + version
Ende Funktion
Funktion api_route_request(manager, request)
    // 路由API请求
    // 参数: manager - 版本管理器, request - 请求
    // 返回值: 响应
    // 1. 从请求头提取版本
    version = request.headers["API-Version"]
    Wenn version == "" then
        version = manager.current
    Ende Wenn
    // 2. 检查版本是否存在
    router = manager.versions[version]
    Wenn router == null then
        // 尝试降级
        version = manager.current
        router = manager.versions[version]
        Wenn router == null then
            Ausgeben "API版本不存在: " + version
            gebe_zurueck {"status": 400, "error": "Invalid API version"}
        Ende Wenn
    Ende Wenn
    // 3. 检查是否已废弃
    Wenn liste_enthaltet(manager.deprecated, version) then
        response.headers["Deprecation"] = "true"
        response.headers["Sunset"] = "2025-01-01"
    Ende Wenn
    // 4. 路由到对应版本
    response = router.route(request)
    Ausgeben "API请求路由: 版本 " + version
    gebe_zurueck response
