    // 参数: bus - 事件总线, event_type - 事件类型
    // data - 事件数据
    subscribers = bus.subscribers[event_type]
    Wenn subscribers == null then
        Ausgeben "没有订阅者: " + event_type
        gebe_zurueck
    Ende Wenn
    i = 0
    Solange i < liste_laenge(subscribers)
        callback = liste_abrufen(subscribers, i)
        // 异步执行回调
        Wenn bus.async then
            spawn_thread(callback, data)
        Sonst
            callback(data)
        Ende Wenn
        i = i + 1
    Ende Solange
    Ausgeben "事件发布: " + event_type + " (" + liste_laenge(subscribers) + " 个订阅者)"
Ende Funktion
