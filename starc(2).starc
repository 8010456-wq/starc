    channel = amqp_open_channel(connection.socket)
    // 声明队列
    amqp_queue_declare(channel, queue)
    // 绑定
    amqp_queue_bind(channel, queue, "amq.direct", queue)
    // 消费
    amqp_basic_consume(channel, queue, callback)
    Ausgeben "RabbitMQ消费开始: " + queue
