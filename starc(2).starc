Funktion memory_pool_create(block_size, pool_size)
    // 内存池分配器 (预分配固定大小块)
    // 参数: block_size - 每个块的大小(字节), pool_size - 总块数
    // 返回值: 内存池对象
    pool = {
        "block_size": block_size,
        "total_blocks": pool_size,
        "free_blocks": [],
        "allocated": 0
    }
