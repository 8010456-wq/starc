        gebe_zurueck null
    Ende Wenn
    // 进入被动模式
    ftp_send(control, "PASV\r\n")
    response = ftp_recv(control)
    ip_port = ftp_parse_pasv(response)
    data_sock = tcp_connect(ip_port.ip, ip_port.port)
    session = {
        "control": control,
        "data": data_sock,
        "host": host,
        "username": username
    }
    Ausgeben "FTP连接成功: " + username + "@" + host
    gebe_zurueck session
Ende Funktion
Funktion ftp_download(session, remote_file, local_file)
    // FTP下载文件
    // 参数: session - FTP会话, remote_file - 远程文件路径
    // local_file - 本地文件路径
    ftp_send(session.control, "RETR " + remote_file + "\r\n")
    data = tcp_recv_all(session.data)
    datei_schreiben(local_file, data)
    ftp_recv(session.control) // 读取传输完成响应
    Ausgeben "FTP下载完成: " + remote_file + " -> " + local_file
Ende Funktion
Funktion ftp_upload(session, local_file, remote_file)
    // FTP上传文件
    // 参数: session - FTP会话, local_file - 本地文件
    // remote_file - 远程文件路径
    data = datei_lesen(local_file)
    ftp_send(session.control, "STOR " + remote_file + "\r\n")
    tcp_send(session.data, data)
    tcp_close(session.data)
    ftp_recv(session.control)
    Ausgeben "FTP上传完成: " + local_file + " -> " + remote_file
