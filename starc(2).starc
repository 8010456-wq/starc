starc语言示例库〈13〉—— 示例610-660
示例610：微服务网关（续）
```starc
Funktion api_gateway_route(gateway, request)
    // API网关路由
    // 参数: gateway - 网关对象, request - 请求对象
    // 返回值: 响应对象
    // 1. 匹配路由
    matched_route = null
    i = 0
    Solange i < liste_laenge(gateway.routes)
        route = liste_abrufen(gateway.routes, i)
        // 检查路径匹配
        Wenn request.path == route.path then
            matched_route = route
            i = liste_laenge(gateway.routes)
        Ende Wenn
        i = i + 1
    Ende Solange
    Wenn matched_route == null then
        Ausgeben "路由未找到: " + request.path
        gebe_zurueck {"status": 404, "body": "Not Found"}
    Ende Wenn
    // 2. 应用中间件
    request = apply_middleware(gateway.middleware, request)
    // 3. 转发请求到后端服务
    response = forward_to_service(matched_route.service, request)
    // 4. 缓存响应
    Wenn matched_route.cacheable then
        gateway.cache[request.path] = response
    Ende Wenn
    Ausgeben "路由完成: " + request.path + " -> " + matched_route.service
    gebe_zurueck response
Ende Funktion
```
示例611：WebSocket 客户端
```starc
Funktion websocket_client_connect(url)
    // WebSocket客户端连接
    // 参数: url - WebSocket URL (ws://或wss://)
    // 返回值: WebSocket连接对象
    // 1. 解析URL
    parts = parse_url(url)
    host = parts.host
    port = parts.port
    path = parts.path
    // 2. 建立TCP连接
    sock = tcp_connect(host, port)
    // 3. 发送握手请求
    key = base64_encode(zufall_byte(16))
    handshake = "GET " + path + " HTTP/1.1\r\n"
    handshake = handshake + "Host: " + host + "\r\n"
    handshake = handshake + "Upgrade: websocket\r\n"
    handshake = handshake + "Connection: Upgrade\r\n"
    handshake = handshake + "Sec-WebSocket-Key: " + key + "\r\n"
    handshake = handshake + "Sec-WebSocket-Version: 13\r\n\r\n"
    tcp_send(sock, handshake)
    // 4. 接收响应
    response = tcp_recv(sock, 1024)
    // 5. 验证握手响应
    Wenn zeichenkette_finden(response, "101") == -1 then
        Ausgeben "WebSocket握手失败"
        gebe_zurueck null
    Ende Wenn
    ws = {
        "socket": sock,
        "connected": wahr,
        "url": url
    }
    Ausgeben "WebSocket客户端连接成功: " + url
    gebe_zurueck ws
Ende Funktion
Funktion websocket_client_send(ws, message)
    // WebSocket发送消息
    // 参数: ws - WebSocket连接, message - 消息内容
    frame = websocket_frame_encode(message, 1) // 文本帧
    tcp_send(ws.socket, frame)
    Ausgeben "WebSocket发送: " + message
Ende Funktion
Funktion websocket_client_recv(ws)
    // WebSocket接收消息
    // 参数: ws - WebSocket连接
    // 返回值: 接收到的消息
    data = tcp_recv(ws.socket, 2048)
    // 解析帧
    frame = websocket_frame_parse(data)
    Wenn frame.opcode == 8 then // 关闭帧
        ws.connected = falsch
        Ausgeben "WebSocket连接已关闭"
        gebe_zurueck null
    Ende Wenn
    Ausgeben "WebSocket接收: " + frame.payload
    gebe_zurueck frame.payload
Ende Funktion
```
示例612：SSH 客户端实现
```starc
Funktion ssh_client_connect(host, port, username, password)
    // SSH客户端连接
    // 参数: host - 主机, port - 端口, username - 用户名, password - 密码
    // 返回值: SSH会话对象
    // 1. TCP连接
    sock = tcp_connect(host, port)
    // 2. SSH版本协商
    version = ssh_send_version(sock)
    // 3. 密钥交换
    kex = ssh_key_exchange(sock)
    // 4. 认证
    auth = ssh_auth_password(sock, username, password)
    Wenn auth == falsch then
        Ausgeben "SSH认证失败"
        gebe_zurueck null
    Ende Wenn
    // 5. 创建会话
    session = {
        "socket": sock,
        "username": username,
        "host": host,
        "channel": null
    }
    Ausgeben "SSH连接成功: " + username + "@" + host
    gebe_zurueck session
Ende Funktion
Funktion ssh_execute(session, command)
    // SSH执行命令
    // 参数: session - SSH会话, command - 命令
    // 返回值: 命令输出
    // 1. 打开通道
    channel = ssh_open_channel(session.socket)
    // 2. 发送exec请求
    ssh_channel_exec(channel, command)
    // 3. 接收输出
    output = ""
    Solange wahr
        data = ssh_channel_read(channel, 4096)
        Wenn data == "" then
            break
        Ende Wenn
        output = output + data
    Ende Solange
    ssh_close_channel(channel)
    Ausgeben "SSH命令执行完成: " + command
    gebe_zurueck output
Ende Funktion
