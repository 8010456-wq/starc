```starc
Funktion task_queue_create(name)
    // 分布式任务队列
    // 参数: name - 队列名称
    // 返回值: 任务队列
    queue = {
        "name": name,
        "tasks": [],
        "processing": {},
        "backend": redis_storage()
    }
    Ausgeben "任务队列创建: " + name
    gebe_zurueck queue
Ende Funktion
Funktion task_enqueue(queue, task_type, payload, priority)
    // 入队任务
    // 参数: queue - 任务队列, task_type - 任务类型
    // payload - 任务数据, priority - 优先级 (0-100)
    task = {
        "id": uuid_generate(),
        "type": task_type,
        "payload": payload,
        "priority": priority,
        "created_at": jetzt(),
        "status": "pending"
    }
    // 按优先级插入
    inserted = falsch
    i = 0
    Solange i < liste_laenge(queue.tasks) and not inserted
        existing = liste_abrufen(queue.tasks, i)
        Wenn priority > existing.priority then
            liste_einfuegen(queue.tasks, i, task)
            inserted = wahr
        Ende Wenn
        i = i + 1
    Ende Solange
    Wenn not inserted then
        liste_einfuegen(queue.tasks, task)
    Ende Wenn
    Ausgeben "任务入队: " + task.id + " (优先级: " + priority + ")"
    gebe_zurueck task.id
Ende Funktion
Funktion task_dequeue(queue, worker_id)
    // 出队任务
    // 参数: queue - 任务队列, worker_id - 工作节点ID
    // 返回值: 任务 或 null
    Wenn liste_laenge(queue.tasks) == 0 then
        Ausgeben "队列为空"
        gebe_zurueck null
    Ende Wenn
    // 取第一个任务
    task = liste_abrufen(queue.tasks, 0)
    liste_entfernen(queue.tasks, 0)
    task.status = "processing"
    task.worker_id = worker_id
    task.started_at = jetzt()
    queue.processing[task.id] = task
    Ausgeben "任务出队: " + task.id + " 分配给 " + worker_id
    gebe_zurueck task
Ende Funktion
```
