Funktion redis_command(client, command, args)
    // 执行Redis命令
    // 参数: client - Redis客户端, command - 命令名
    // args - 参数列表
    // 返回值: 响应数据
    // 构建RESP请求
    request = "*" + (1 + liste_laenge(args)) + "\r\n"
    request = request + "$" + zeichenkette_laenge(command) + "\r\n" + command + "\r\n"
    i = 0
    Solange i < liste_laenge(args)
        arg = liste_abrufen(args, i)
        request = request + "$" + zeichenkette_laenge(arg) + "\r\n" + arg + "\r\n"
        i = i + 1
    Ende Solange
    // 发送并接收
    tcp_send(client.socket, request)
    response = tcp_recv(client.socket, 4096)
    // 解析RESP响应
    result = resp_parse(response)
    Ausgeben "Redis命令执行: " + command
    gebe_zurueck result
Ende Funktion
Funktion redis_set(client, key, value)
    // Redis SET命令
    // 参数: client - Redis客户端, key - 键, value - 值
    // 返回值: 执行结果
    result = redis_command(client, "SET", [key, value])
    Ausgeben "Redis SET: " + key + " = " + value
    gebe_zurueck result
Ende Funktion
Funktion redis_get(client, key)
    // Redis GET命令
    // 参数: client - Redis客户端, key - 键
    // 返回值: 值
    result = redis_command(client, "GET", [key])
    Ausgeben "Redis GET: " + key + " -> " + result
    gebe_zurueck result
