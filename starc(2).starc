Funktion rabbitmq_publish(connection, exchange, routing_key, message)
    // RabbitMQ发布消息
    // 参数: connection - 连接, exchange - 交换机
    // routing_key - 路由键, message - 消息
    // 1. 打开通道
    channel = amqp_open_channel(connection.socket)
    // 2. 声明交换机
    amqp_exchange_declare(channel, exchange)
    // 3. 发布消息
    amqp_basic_publish(channel, exchange, routing_key, message)
    // 4. 关闭通道
    amqp_close_channel(channel)
    Ausgeben "RabbitMQ发布: " + routing_key + " -> " + message
