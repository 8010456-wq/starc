    gebe_zurueck pool
Ende Funktion
Funktion memory_pool_alloc(pool)
    // 从内存池分配块
    // 参数: pool - 内存池
    // 返回值: 分配的内存块 或 null
    Wenn liste_laenge(pool.free_blocks) == 0 then
        Ausgeben "内存池已耗尽"
        gebe_zurueck null
    Ende Wenn
    block = liste_abrufen(pool.free_blocks, 0)
    liste_entfernen(pool.free_blocks, 0)
    pool.allocated = pool.allocated + 1
    Ausgeben "内存池分配，已分配: " + pool.allocated + "/" + pool.total_blocks
    gebe_zurueck block
Ende Funktion
Funktion memory_pool_free(pool, block)
