    // Nacos心跳 (定时)
    // 参数: server - Nacos服务器, service_name - 服务名
    // ip - 服务IP, port - 服务端口
    Solange wahr
        system_schlafen(5000) // 每5秒
        url = "http://" + server + "/nacos/v1/ns/instance/heartbeat"
        params = "serviceName=" + service_name
        params = params + "&ip=" + ip
