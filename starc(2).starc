    gebe_zurueck manager
Ende Funktion
Funktion hot_reload_module(manager, module_path)
    // 加载/重载模块
    // 参数: manager - 管理器, module_path - 模块路径
    // 返回值: 模块对象
    // 1. 检查文件是否变化
    current_mtime = file_mtime(module_path)
    existing = manager.modules[module_path]
    Wenn existing != null and existing.mtime == current_mtime then
        Ausgeben "模块无变化: " + module_path
        gebe_zurueck existing.module
    Ende Wenn
    // 2. 加载新模块
    new_module = load_module(module_path)
    // 3. 更新管理器
    manager.modules[module_path] = {
        "module": new_module,
        "mtime": current_mtime,
        "version": manager.version + 1
    }
    manager.version = manager.version + 1
    // 4. 通知所有观察者
    notify_reload(manager.watchers, module_path, new_module)
    Ausgeben "模块热更新: " + module_path + " (版本: " + manager.version + ")"
    gebe_zurueck new_module
Ende Funktion
```
