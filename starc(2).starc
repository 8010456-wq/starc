Funktion rpc_server_init(service, port)
    // RPC服务器初始化
    // 参数: service - 服务对象, port - 监听端口
    // 返回值: RPC服务器
    server = {
        "service": service,
        "port": port,
        "methods": {},
        "middleware": []
    }
    // 注册方法
    i = 0
    Solange i < liste_laenge(service.methods)
        method = liste_abrufen(service.methods, i)
        server.methods[method.name] = method
        i = i + 1
    Ende Solange
    // 启动监听
    rpc_start_listen(server)
    Ausgeben "RPC服务器启动，端口: " + port
    gebe_zurueck server
Ende Funktion
Funktion rpc_client_call(server_addr, method_name, params)
    // RPC客户端调用
    // 参数: server_addr - 服务器地址, method_name - 方法名
    // params - 参数列表
    // 返回值: 调用结果
    // 1. 构建RPC请求
    request = {
        "jsonrpc": "2.0",
        "method": method_name,
        "params": params,
        "id": uuid_generate()
    }
    // 2. 序列化为JSON
    json_request = json_encode(request)
    // 3. 发送请求
    response = http_post(server_addr + "/rpc", json_request)
    // 4. 解析响应
    Wenn response != "" then
        result = json_decode(response)
        Wenn result.error != null then
            Ausgeben "RPC错误: " + result.error.message
            gebe_zurueck null
        Ende Wenn
        Ausgeben "RPC调用成功: " + method_name
        gebe_zurueck result.result
    Sonst
        Ausgeben "RPC调用失败"
        gebe_zurueck null
    Ende Wenn
Ende Funktion
