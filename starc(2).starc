示例635：自定义二进制协议解析
```starc
Funktion binary_protocol_parse(data, spec)
    // 自定义二进制协议解析
    // 参数: data - 原始数据, spec - 协议规范
    // [{name, type, length, byte_order}]
    // 返回值: 解析后的字段字典
    pos = 0
    result = {}
    i = 0
    Solange i < liste_laenge(spec)
        field = liste_abrufen(spec, i)
        name = field.name
        typ = field.type
        length = field.length
        byte_order = field.byte_order
        // 根据类型解析
        Wenn typ == "uint8" then
            value = bytes_to_uint(data[pos:pos+1])
            pos = pos + 1
        Sonst Wenn typ == "uint16" then
            value = bytes_to_uint16(data[pos:pos+2], byte_order)
            pos = pos + 2
        Sonst Wenn typ == "uint32" then
            value = bytes_to_uint32(data[pos:pos+4], byte_order)
            pos = pos + 4
        Sonst Wenn typ == "uint64" then
            value = bytes_to_uint64(data[pos:pos+8], byte_order)
            pos = pos + 8
        Sonst Wenn typ == "string" then
            value = data[pos:pos+length]
            pos = pos + length
        Sonst Wenn typ == "bytes" then
            len = bytes_to_uint(data[pos:pos+length])
            pos = pos + length
            value = data[pos:pos+len]
            pos = pos + len
        Ende Wenn
        result[name] = value
        i = i + 1
    Ende Solange
    Ausgeben "二进制协议解析完成，解析 " + liste_laenge(spec) + " 个字段"
    gebe_zurueck result
Ende Funktion
Funktion binary_protocol_build(fields, spec)
    // 构建二进制协议
    // 参数: fields - 字段值字典, spec - 协议规范
    // 返回值: 二进制数据
    data = ""
    i = 0
    Solange i < liste_laenge(spec)
        field = liste_abrufen(spec, i)
        name = field.name
        typ = field.type
        value = fields[name]
        Wenn typ == "uint8" then
            data = data + uint8_to_bytes(value)
        Sonst Wenn typ == "uint16" then
            data = data + uint16_to_bytes(value, field.byte_order)
        Sonst Wenn typ == "uint32" then
            data = data + uint32_to_bytes(value, field.byte_order)
        Sonst Wenn typ == "string" then
            data = data + value
        Ende Wenn
        i = i + 1
    Ende Solange
    Ausgeben "二进制协议构建完成，长度: " + zeichenkette_laenge(data)
    gebe_zurueck data
Ende Funktion
```
