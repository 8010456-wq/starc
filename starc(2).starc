示例636：状态机实现
```starc
Funktion state_machine_create(initial_state, transitions)
    // 状态机创建
    // 参数: initial_state - 初始状态
    // transitions - 状态转换表 [{from, event, to, action}]
    // 返回值: 状态机对象
    machine = {
        "current": initial_state,
        "transitions": transitions,
        "history": [],
        "listeners": []
    }
    Ausgeben "状态机创建完成，初始状态: " + initial_state
    gebe_zurueck machine
Ende Funktion
Funktion state_machine_fire(machine, event)
    // 触发事件
    // 参数: machine - 状态机, event - 事件
    // 返回值: 是否转换成功
    // 1. 查找匹配的转换
    matched = null
    i = 0
    Solange i < liste_laenge(machine.transitions)
        trans = liste_abrufen(machine.transitions, i)
        Wenn trans.from == machine.current and trans.event == event then
            matched = trans
            i = liste_laenge(machine.transitions)
        Ende Wenn
        i = i + 1
    Ende Solange
    Wenn matched == null then
        Ausgeben "状态机: 事件 " + event + " 在当前状态 " + machine.current + " 无效"
        gebe_zurueck falsch
    Ende Wenn
    // 2. 记录历史
    machine.history = [machine.current, event]
    // 3. 执行动作
    Wenn matched.action != null then
        matched.action()
    Ende Wenn
    // 4. 切换状态
    machine.current = matched.to
    // 5. 通知监听器
    notify_state_change(machine.listeners, machine.current, event)
    Ausgeben "状态机: " + matched.from + " --" + event + "--> " + matched.to
    gebe_zurueck wahr
Ende Funktion
