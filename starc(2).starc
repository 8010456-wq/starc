Funktion consul_register(server, service_name, port)
    // Consul服务注册
    // 参数: server - Consul服务器, service_name - 服务名
    // port - 服务端口
    // 返回值: 服务ID
    // 1. 构建注册请求
    service_id = uuid_generate()
    body = {
        "ID": service_id,
        "Name": service_name,
        "Port": port,
        "Check": {
            "HTTP": "http://localhost:" + port + "/health",
            "Interval": "10s"
        }
    }
    json_body = json_encode(body)
    // 2. 发送PUT请求
    url = "http://" + server + "/v1/agent/service/register"
    response = http_put(url, json_body)
    Ausgeben "Consul注册成功: " + service_name + " (ID: " + service_id + ")"
    gebe_zurueck service_id
Ende Funktion
Funktion consul_discover(server, service_name)
    // Consul服务发现
    // 参数: server - Consul服务器, service_name - 服务名
    // 返回值: 服务实例列表
    url = "http://" + server + "/v1/health/service/" + service_name
    response = http_get(url)
    instances = json_decode(response)
    result = []
    i = 0
    Solange i < liste_laenge(instances)
        inst = liste_abrufen(instances, i)
        Wenn inst.CheckStatus == "passing" then
            service = inst.Service
            address = service.Address
            port = service.Port
            liste_einfuegen(result, {"address": address, "port": port})
        Ende Wenn
        i = i + 1
    Ende Solange
    Ausgeben "Consul发现: " + service_name + " 找到 " + liste_laenge(result) + " 个实例"
    gebe_zurueck result
Ende Funktion
```
