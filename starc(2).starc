Funktion cron_schedule(scheduler, job_name, cron_expr, task)
    // 调度定时任务
    // 参数: scheduler - 调度器, job_name - 任务名称
    // cron_expr - Cron表达式, task - 任务函数
    // 解析Cron表达式
    schedule = parse_cron(cron_expr)
    job = {
        "name": job_name,
        "schedule": schedule,
        "task": task,
        "last_run": 0,
        "next_run": schedule.next(jetzt())
    }
    scheduler.jobs[job_name] = job
    // 通过共识同步
    consensus_sync(scheduler.consensus, job)
    Ausgeben "Cron任务调度成功: " + job_name + " " + cron_expr
    gebe_zurueck job
