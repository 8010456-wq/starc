Ende Funktion
Funktion test_suite_run(suite)
    // 运行测试套件
    // 参数: suite - 测试套件
    // 返回值: 测试结果统计
    passed = 0
    failed = 0
    // 执行setup
    Wenn suite.setup != null then
        suite.setup()
    Ende Wenn
    i = 0
    Solange i < liste_laenge(suite.tests)
        test = liste_abrufen(suite.tests, i)
        start = jetzt()
        // 执行测试
        try
            result = test.fn()
            test.result = result
            Wenn result then
                passed = passed + 1
                Ausgeben "✅ PASS: " + test.name
            Sonst
                failed = failed + 1
                Ausgeben "❌ FAIL: " + test.name
            Ende Wenn
        catch (error)
            test.error = error
            failed = failed + 1
            Ausgeben " ERROR: " + test.name + " - " + error
        Ende Versuch
        test.duration = jetzt() - start
        i = i + 1
    Ende Solange
    // 执行teardown
    Wenn suite.teardown != null then
        suite.teardown()
    Ende Wenn
    Ausgeben "测试完成: " + passed + " 通过, " + failed + " 失败"
    gebe_zurueck {"passed": passed, "failed": failed, "total": passed + failed}
Ende Funktion
```
