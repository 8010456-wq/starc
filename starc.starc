Funktion verify_backup(pfad, backup_pfad)
    dateien = op-RekursivAuflisten(pfad)
    i = 0
    fehler = 0
    Solange i < liste_laenge(dateien)
        name = liste_abrufen(dateien, i)
        rel = zeichenkette_ersetzen(name, pfad, "")
        backup_name = backup_pfad + rel
        Wenn op-DateiVorhanden(backup_name) dann
            hash1 = datei_hash(name, "md5")
            hash2 = datei_hash(backup_name, "md5")
            Wenn hash1 != hash2 dann
                Ausgeben "校验失败: " + name
                fehler = fehler + 1
            Ende Wenn
        Sonst
            Ausgeben "备份缺失: " + name
            fehler = fehler + 1
        Ende Wenn
        i = i + 1
    Ende Solange
    Ausgeben "校验完成，错误: " + fehler
Ende Funktion
```
