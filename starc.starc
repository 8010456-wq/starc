Funktion extract_tags(pfad, start_tag, end_tag)
    inhalt = datei_lesen(pfad)
    ergebnis = []
    i = 0
    Solange i < zeichenkette_laenge(inhalt)
        pos_start = zeichenkette_finden(inhalt, start_tag, i)
        Wenn pos_start != -1 dann
            pos_end = zeichenkette_finden(inhalt, end_tag, pos_start + zeichenkette_laenge(start_tag))
            Wenn pos_end != -1 dann
                tag = zeichenkette_teil(inhalt, pos_start + zeichenkette_laenge(start_tag), pos_end)
                liste_einfuegen(ergebnis, tag)
                i = pos_end + zeichenkette_laenge(end_tag)
            Sonst
                i = zeichenkette_laenge(inhalt)
            Ende Wenn
        Sonst
            i = zeichenkette_laenge(inhalt)
        Ende Wenn
    Ende Solange
    Ausgeben "标签提取: " + ergebnis
Ende Funktion
