        rauschen = generate_noise(32, 100)
        gefälscht = generator_vorhersage(generator, rauschen)
        d_echt = discriminator_train(discriminator, echt, 1)
        d_falsch = discriminator_train(discriminator, gefälscht, 0)
        rauschen = generate_noise(32, 100)
