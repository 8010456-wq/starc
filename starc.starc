    fb = op-RekursivAuflisten(b)
    i = 0
    Solange i < liste_laenge(fa)
        name = liste_abrufen(fa, i)
        Wenn not liste_enthaltet(fb, name) dann
            Ausgeben "仅在 " + a + ": " + name
        Ende Wenn
        i = i + 1
    Ende Solange
    i = 0
    Solange i < liste_laenge(fb)
        name = liste_abrufen(fb, i)
        Wenn not liste_enthaltet(fa, name) dann
            Ausgeben "仅在 " + b + ": " + name
        Ende Wenn
        i = i + 1
    Ende Solange
Ende Funktion
