Funktion extract_numbers(pfad)
    inhalt = datei_lesen(pfad)
    zahlen = []
    i = 0
    Solange i < zeichenkette_laenge(inhalt)
        c = zeichen_bei(inhalt, i)
        Wenn c >= "0" und c <= "9" dann
            start = i
            Solange i < zeichenkette_laenge(inhalt) und zeichen_bei(inhalt, i) >= "0" und zeichen_bei(inhalt, i) <= "9"
                i = i + 1
            Ende Solange
            zahl = zeichenkette_teil(inhalt, start, i)
            liste_einfuegen(zahlen, zahl)
        Sonst
            i = i + 1
        Ende Wenn
    Ende Solange
    Ausgeben "数字提取完成: " + zahlen
Ende Funktion
