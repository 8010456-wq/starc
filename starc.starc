Funktion particle_system(x, y, anzahl)
    i = 0
    Solange i < anzahl
        p = erstelle_particle(x, y)
        p.vx = zufall_ganz(-5, 5)
        p.vy = zufall_ganz(-10, 0)
        p.leben = zufall_ganz(20, 60)
        liste_einfuegen(particles, p)
        i = i + 1
    Ende Solange
    Solange laeuft
        i = 0
        Solange i < liste_laenge(particles)
            p = liste_abrufen(particles, i)
            p.x = p.x + p.vx
            p.y = p.y + p.vy
            p.leben = p.leben - 1
            zeichne_punkt(p.x, p.y)
            Wenn p.leben <= 0 dann
                liste_entfernen(particles, i)
            Sonst
                i = i + 1
            Ende Wenn
        Ende Solange
        system_schlafen(16)
    Ende Solange
Ende Funktion
