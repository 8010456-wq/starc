Funktion bulk_convert_newlines(pfad, target)
    dateien = op-RekursivAuflisten(pfad)
    i = 0
    Solange i < liste_laenge(dateien)
        name = liste_abrufen(dateien, i)
        inhalt = datei_lesen(name)
        Wenn target == "LF" dann
            inhalt = zeichenkette_ersetzen(inhalt, "\r\n", "\n")
        Sonst Wenn target == "CRLF" dann
            inhalt = zeichenkette_ersetzen(inhalt, "\n", "\r\n")
        Sonst Wenn target == "CR" dann
            inhalt = zeichenkette_ersetzen(inhalt, "\n", "\r")
        Ende Wenn
