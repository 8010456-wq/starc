            knoten = liste_abrufen(knoten, j)
            nachbarn = graph_nachbarn(graph, knoten)
            aggregiert = aggregate_features(features, nachbarn)
            neue_features[knoten] = update_feature(features[knoten], aggregiert)
            j = j + 1
        Ende Solange
        features = neue_features
        i = i + 1
    Ende Solange
    Ausgeben "图神经网络训练完成"
    gebe_zurueck features
Ende Funktion
```
