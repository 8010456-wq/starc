Funktion attention_mechanism(query, keys, values)
    gewichte = []
    summe = 0
    i = 0
    Solange i < liste_laenge(keys)
        key = liste_abrufen(keys, i)
        score = dot_product(query, key)
        liste_einfuegen(gewichte, score)
        summe = summe + score
        i = i + 1
    Ende Solange
    i = 0
    Solange i < liste_laenge(gewichte)
        gewichte[i] = gewichte[i] / summe
        i = i + 1
    Ende Solange
    ergebnis = []
    i = 0
    Solange i < liste_laenge(values)
        wert = liste_abrufen(values, i)
        ergebnis = ergebnis + gewichte[i] * wert
        i = i + 1
    Ende Solange
    gebe_zurueck ergebnis
