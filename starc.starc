        input = liste_teil(daten, i, i + fenster)
        label = liste_teil(daten, i + fenster, i + fenster + vorhersage)
        liste_einfuegen(train_daten, input)
        liste_einfuegen(train_labels, label)
        i = i + 1
    Ende Solange
